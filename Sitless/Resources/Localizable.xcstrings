    },
    "Sitless has no account, no cloud backend, and no third-party analytics. Your standing, activity, and sleep data stays on this device and inside Apple Health." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitless has no account, no cloud backend, and no third-party analytics. Your standing, activity, and sleep data stays on this device and inside Apple Health."
          }
        }
      }
    },
    "Sitless helps you understand how much of your day you spend standing." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitless helps you understand how much of your day you spend standing."
          }
        }
      }
    },
    "Sitless reads standing, activity, and sleep data from Apple Health to build your daily picture. Motion access lets the inactivity reminder stay quiet while you're driving. Nothing leaves your device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitless reads standing, activity, and sleep data from Apple Health to build your daily picture. Motion access lets the inactivity reminder stay quiet while you're driving. Nothing leaves your device."
          }
        }
      }
    },
    "Sitless reads your standing time from Apple Health to show how much of today you spent standing versus sitting. Your health data always stays on this device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitless reads your standing time from Apple Health to show how much of today you spent standing versus sitting. Your health data always stays on this device."
          }
        }
      }
    },
    "Sitless turns that information into simple daily and weekly trends." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
